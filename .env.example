# Copy to .env; replace all three placeholders with independent random secrets.
POSTGRES_PASSWORD=replace-with-a-random-database-password
CALL_COACH_PASSWORD=replace-with-a-long-shared-password
CALL_COACH_API_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://127.0.0.1:3000
COOKIE_SECURE=false
WEB_PORT=3000
COMPONENT_PREVIEW=false
